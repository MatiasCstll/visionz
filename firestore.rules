rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    // Solo se puede tocar UN item por vez (más el campo 'last')
    function onlyChanged(k) {
      return resource == null
        ? request.resource.data.keys().hasOnly([k, 'last'])
        : request.resource.data.diff(resource.data).affectedKeys().hasOnly([k, 'last']);
    }

    // Descargas: solo se puede sumar de a 1
    function isDownloadIncrement() {
      let d = request.resource.data;
      let k = d.last;
      let old = resource == null ? 0 : resource.data.get(k, 0);
      return k is string && k != 'last' && onlyChanged(k) && d[k] == old + 1;
    }

    // Estrellas: un voto por vez, de 1 a 5
    function isRatingChange() {
      let d = request.resource.data;
      let k = d.last;
      let old = resource == null ? {'s': 0, 'c': 0} : resource.data.get(k, {'s': 0, 'c': 0});
      let n = d[k];
      return signedIn() && k is string && k != 'last' && onlyChanged(k)
        && n.keys().hasOnly(['s', 'c'])
        && n.s is int && n.c is int
        && (n.c - old.c) in [-1, 0, 1]
        && (n.s - old.s) >= -5 && (n.s - old.s) <= 5
        && n.c >= 0 && n.s >= 0 && n.s <= n.c * 5;
    }

    match /stats/downloads {
      allow read: if true;
      allow create, update: if isDownloadIncrement();
    }

    match /stats/ratings {
      allow read: if true;
      allow create, update: if isRatingChange();
    }

    match /stats/meta {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['users'])
        && request.resource.data.users == (resource == null ? 0 : resource.data.get('users', 0)) + 1;
    }

    // Perfil de cada usuario: solo lo ve y edita su dueño (o un admin)
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.isAdmin == false;
      allow update: if signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'joined', 'email', 'username']);
      allow delete: if isAdmin();
    }

    // Nombres de usuario reservados (para que no se repitan)
    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}
